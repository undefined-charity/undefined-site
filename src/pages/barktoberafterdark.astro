---
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";

const rsvpUrl = "https://partiful.com/e/UkUnU4oIYRRXUBzmaUtu?c=wA7A4SNO";
const donateUrl = "https://donate.stripe.com/4gM4gz9Ic8AF6r31Vm1oI05";
---

<BaseLayout
  title="Barktober After Dark"
  description="Barktober After Dark — a late-night after party at the Kink Center brought to you by Undefined, led by RussellBun."
>
  <PageHeader
    title="Barktober After Dark"
    description="A late-night after party at the Kink Center 😈"
  />

  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-8">
          <div class="glass rounded-lg p-8 space-y-10">
            <div>
              <p class="text-sm uppercase tracking-wide text-orange-400">Saturday, October 3 2026 · 11:00 PM – 2:00 AM</p>
              <h2 class="h3 mb-2">After Dark at the Kink Center</h2>
              <p>
                Brought to you by Undefined, led by RussellBun.
                Join us at the Kink Center.
              </p>
            </div>

            <div>
              <h3 class="h4 mb-4">What to Expect</h3>
              <ul class="list-disc pl-6 space-y-3">
                <li>Blacklights, slings, cuddle spaces, furry porn — something for everyone.</li>
                <li>This one is BYOB — bring your own drinks. Some light snacks will be provided.</li>
                <li>Remember that consent is sexy — and being impaired means you can't consent.</li>
              </ul>
            </div>

            <div>
              <h3 class="h4 mb-4">Capacity</h3>
              <ul class="list-disc pl-6 space-y-3">
                <li>The venue's max capacity is 70. We don't expect to hit it, but we'll be keeping an eye on the room throughout the night.</li>
                <li>If we do reach capacity, entry will be 1-in, 1-out until space opens up, and we'll send updates through Partiful and text if needed.</li>
                <li>We can't guarantee immediate entry based on whether you donated. If you choose not to wait, or don't get in before the event ends, we'll happily refund your donation.</li>
                <li>If your plans change, please update your RSVP so there's room for everyone who wants to attend.</li>
              </ul>
            </div>

            <div>
              <h3 class="h4 mb-4">RSVP</h3>
              <p class="mb-4">
                RSVP Now! Grab your spot:
              </p>
              <a
                href={rsvpUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-orange-600 text-white hover:bg-orange-700 transition"
              >
                RSVP for Barktober After Dark
              </a>
            </div>

            <div class="p-6 rounded-lg bg-orange-600/20 border border-orange-600/40 space-y-3">
              <h3 class="h5">Support Barktober After Dark</h3>
              <p>
                This event is pay-what-you-can. Your donation helps cover the costs of the venue and supplies.
                It's not required — but every bit helps us keep throwing events like this!
              </p>
              <a
                href={donateUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-orange-600 text-white hover:bg-orange-700 transition"
              >
                Donate — Pay What You Can
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
